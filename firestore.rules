
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: get the current user's document
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: check if the user has a specific role
    function hasRole(role) {
      let user = getCurrentUser();
      return request.auth != null && user != null && user.role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isLeader() {
      return hasRole('Leader');
    }

    match /users/{userId} {
      // Reading:
      // 1. Users can read their own record.
      // 2. Admins can read any record.
      // 3. Leaders can read records where they are the assigned leader.
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      );

      // Creating: 
      // 1. Users can create their own record during initialization.
      // 2. Admins can create any record.
      // 3. Leaders can create records for members assigned to them.
      allow create: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && request.resource.data.assignedLeaderId == request.auth.uid)
      );

      // Updating:
      // 1. Users can update their own record (except role).
      // 2. Admins can update any record (including role).
      // 3. Leaders can update records of members assigned to them (except role).
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      ) && (
        // CRITICAL: Only Admins can change the 'role' field.
        request.resource.data.role == resource.data.role || isAdmin()
      );

      // Deleting: Only Admins can remove user records.
      allow delete: if isAdmin();
    }
  }
}
