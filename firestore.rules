
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Optimization: Read role from the document
    // We use getAfter if we want to check state after a write, 
    // but for simple reads get() is standard.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'Admin';
    }

    function isLeader() {
      return isAuthenticated() && getUserData().role == 'Leader';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {

      // READ SINGLE DOCUMENT
      allow get: if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      );

      // LIST USERS
      // Simplified list rule to avoid startup race conditions with get()
      // The frontend handles filtering by assignedLeaderId
      allow list: if isAuthenticated();

      // CREATE USER
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isLeader() && request.resource.data.assignedLeaderId == request.auth.uid)
      );

      // UPDATE USER
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      );

      // DELETE USER
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      );
    }
  }
}
