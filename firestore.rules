
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().data.get('role', '') == 'Admin';
    }

    function isLeader() {
      return isAuthenticated() && getUserData().data.get('role', '') == 'Leader';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isLeader() && resource.data.get('assignedLeaderId', '') == request.auth.uid)
      );

      // Allow listing for dashboard/members (authenticated)
      // AND allow limited listing for password reset (unauthenticated email check)
      allow list: if isAuthenticated() || (request.auth == null && request.query.limit <= 5);

      allow create: if isAuthenticated() || request.auth == null;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isLeader() && (resource.data.assignedLeaderId == request.auth.uid || request.resource.data.assignedLeaderId == request.auth.uid))
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      );
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isAdmin() || isLeader());
      allow create: if isAuthenticated() && (isAdmin() || isLeader());
      allow update: if isAuthenticated() && (isAdmin() || (isLeader() && resource.data.leaderId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
