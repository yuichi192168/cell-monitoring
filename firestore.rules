
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getRole() == 'Admin';
    }

    function isLeader() {
      return request.auth != null && getRole() == 'Leader';
    }

    match /users/{userId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && get(/databases/$(database)/documents/users/$(userId)).data.assignedLeaderId == request.auth.uid)
      );
      
      allow list: if request.auth != null && (
        isAdmin() || 
        (isLeader() && request.query.filters.assignedLeaderId == request.auth.uid)
      );

      allow create: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && request.resource.data.assignedLeaderId == request.auth.uid)
      );

      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      );

      allow delete: if request.auth != null && (
        isAdmin() || 
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      );
    }
  }
}
