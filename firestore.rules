
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(role) {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isLeader() {
      return hasRole('Leader');
    }

    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin() || (isLeader() && get(/databases/$(database)/documents/users/$(userId)).data.assignedLeaderId == request.auth.uid));
      
      allow list: if request.auth != null && (
        isAdmin() || 
        (isLeader() && request.query.filters.assignedLeaderId == request.auth.uid)
      );

      allow create: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && request.resource.data.assignedLeaderId == request.auth.uid)
      );

      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isLeader() && resource.data.assignedLeaderId == request.auth.uid)
      ) && (
        request.resource.data.role == resource.data.role || isAdmin()
      );

      allow delete: if isAdmin();
    }
  }
}
